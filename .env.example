# Copy this file to `.env` at the repository root, then fill in your key.
#
#   cp .env.example .env
#
# This is the only configuration the app needs. The server refuses to start
# without OPENAI_API_KEY and tells you exactly what is missing.

OPENAI_API_KEY=sk-your-key-here

# Optional. Port the Express API listens on. The Vite dev server proxies
# /api to it, so you only ever open the client URL. Default: 3001
# PORT=3001
